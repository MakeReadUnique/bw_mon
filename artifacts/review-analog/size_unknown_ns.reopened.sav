; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 10 10 1600 760 300 110

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "../acceptance/size_unknown_ns/waves.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 100.000000 118.000000 1n
cursor 105.500000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
userMarker 115 COMPLETE115ns ID_YELLOW5 long_dashed
userMarker 103.9 UNKNOWN103.9ns ID_YELLOW5 long_dashed

; visible top row signal index
top 0
; marker line index
markerPos 0

; rename signal list
; addRenameSig new_name org_name
activeDirFile "" "../acceptance/size_unknown_ns/waves.fsdb"

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/mon/p0_GBps" "/tb_acceptance_ns/scene/ports[0]/dut/mon/bandwidth_gbps"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/all_dmc/all_dmc_GBps" "/tb_acceptance_ns/scene/all_dmc/bandwidth_gbps"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/p0_valid" "/tb_acceptance_ns/scene/ports[0]/dut/valid"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/p0_bytes_per_event" "/tb_acceptance_ns/scene/ports[0]/dut/accounted_bytes[63:0]"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/p0_size_known" "/tb_acceptance_ns/scene/ports[0]/dut/accounted_known"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/mon/p0_bytes_complete" "/tb_acceptance_ns/scene/ports[0]/dut/mon/bytes_complete"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/ports[0]/dut/mon/p0_events_complete" "/tb_acceptance_ns/scene/ports[0]/dut/mon/events_complete"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_acceptance_ns/scene/all_dmc/all_dmc_bytes_complete" "/tb_acceptance_ns/scene/all_dmc/bytes_complete"

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "W=10ns S=1ns | GB/s"
activeDirFile "" "../acceptance/size_unknown_ns/waves.fsdb"
addSignal -w analog -ds pwc -c ID_CYAN5 -ls solid -lw 2 -h 210 -gy -ry -va 64.96.128.0.0.0.0.0 64.92.0.0.0.0.0.0 /tb_acceptance_ns/scene/ports[0]/dut/mon/p0_GBps
addSignal -w analog -ds pwc -c ID_ORANGE5 -ls solid -lw 2 -h 210 -gy -ry -va 64.144.64.0.0.0.0.0 64.143.64.0.0.0.0.0 /tb_acceptance_ns/scene/all_dmc/all_dmc_GBps
addSignal -h 23 /tb_acceptance_ns/scene/ports[0]/dut/p0_valid
addSignal -h 23 -UNSIGNED -UDEC -holdScope p0_bytes_per_event
addSignal -h 23 -holdScope p0_size_known
addSignal -h 23 /tb_acceptance_ns/scene/ports[0]/dut/mon/p0_bytes_complete
addSignal -h 23 -holdScope p0_events_complete
addSignal -h 23 /tb_acceptance_ns/scene/all_dmc/all_dmc_bytes_complete
addGroup "END"

