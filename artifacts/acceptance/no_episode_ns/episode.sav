Magic 271485
Revision Verdi_W-2024.09-SP1

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 10 10 1500 850 760 180

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "waves.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 18.000000 56.000000 1n
cursor 53.000001
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 28

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "waves.fsdb"
addSignal -h 16 /tb_acceptance_ns/scene/ports[0]/dut/mon/scope_id
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_id[63:0]
addSignal -h 16 -holdScope episode_active
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_first_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_bytes[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_episode_id[63:0]
addSignal -h 16 -UNSIGNED -holdScope episode_result_status[2:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_first_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_last_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_tail_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_confirmation_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_byte_count[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_event_count[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_duration_ticks[63:0]
addSignal -h 16 -holdScope episode_result_tail_known
addSignal -h 16 -holdScope episode_result_bytes_complete
addSignal -h 16 -holdScope episode_result_e2e_valid
addSignal -w digital -c ID_RED5 -ls solid -lw 1 -h 16 -holdScope episode_result_e2e_gbps
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_result_result_seq[63:0]
addSignal -h 16 -holdScope episode_last_steady_selection_valid
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_last_steady_start_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope episode_last_steady_end_ticks[63:0]
addSignal -h 16 -holdScope episode_last_steady_bandwidth_valid
addSignal -w digital -c ID_ORANGE5 -ls solid -lw 1 -h 16 -holdScope episode_last_steady_bandwidth_gbps
addSignal -w digital -c ID_YELLOW5 -ls solid -lw 1 -h 16 -holdScope episode_last_steady_variation_mean_gbps
addSignal -w digital -c ID_GREEN5 -ls solid -lw 1 -h 16 -holdScope episode_last_steady_variation_stddev_gbps
addSignal -h 16 -holdScope episode_variation_cv_valid
addSignal -w digital -c ID_CYAN5 -ls solid -lw 1 -h 16 -holdScope episode_variation_cv_pct
addGroup "G2"

