Magic 271485
Revision Verdi_W-2024.09-SP1

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 10 10 1500 850 760 180

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "waves.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 78.000000 103.000000 1n
cursor 90.000001
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 21

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "waves.fsdb"
addSignal -h 16 /tb_acceptance_cycle/scene/ports[1]/dut/clk
addSignal -h 16 -holdScope valid
addSignal -h 16 -holdScope ready
addSignal -h 16 /tb_acceptance_cycle/scene/ports[1]/dut/mon/backpressure_supported
addSignal -h 16 -holdScope backpressure_enabled
addSignal -h 16 -holdScope backpressure_trusted
addSignal -h 16 -holdScope backpressure_active
addSignal -h 16 -holdScope backpressure_hit
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_start_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_trigger_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_end_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_duration_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_hit_count[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope backpressure_interval_count[63:0]
addSignal -h 16 -UNSIGNED -holdScope backpressure_end_reason[2:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope result_seq[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope accepted_record_seq[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope total_bytes[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope window_start_ticks[63:0]
addSignal -h 16 -UNSIGNED -UDEC -holdScope window_end_ticks[63:0]
addSignal -w digital -c ID_RED5 -ls solid -lw 1 -h 16 -holdScope bandwidth_gbps
addGroup "G2"

