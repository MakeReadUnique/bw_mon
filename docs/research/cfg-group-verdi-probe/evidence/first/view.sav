Magic 271485
Revision Verdi_W-2024.09-SP1

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 10 10 1660 900 600 130

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "waves.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 0.000000 49.000000 1n
cursor 18.001000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 8

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "waves.fsdb"
addSignal -h 15 /tb_cfg_group_probe/wave_slots[0]/group_id
addSignal -h 15 -holdScope active
addSignal -w analog -ds pwc -c ID_CYAN5 -ls solid -lw 2 -h 175 -holdScope bandwidth_gbps
addSignal -h 15 -UNSIGNED -UDEC -holdScope result_seq[63:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope window_bytes[63:0]
addSignal -h 15 -holdScope window_full
addSignal -h 15 -holdScope bytes_complete
addSignal -h 15 -UNSIGNED -holdScope probe_state[1:0]
addGroup "G2"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm

